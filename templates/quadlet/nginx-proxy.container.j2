# Managed by Ansible — do not edit manually
# Role: quadlets | Service: nginx-proxy (jwilder/nginx-proxy)
#
# Systemd specifiers used here:
#   %E  → $XDG_CONFIG_HOME  (rootless: ~/.config/,  rootful: /etc/)
#   %t  → $XDG_RUNTIME_DIR  (rootless: /run/user/UID/, rootful: /run/)

[Unit]
Description=jwilder nginx reverse proxy
After=network-online.target podman.socket
Requires=podman.socket

[Container]
Image={{ quadlets_nginx_proxy_image }}
ContainerName=nginx-proxy

PublishPort={{ quadlets_nginx_proxy_http_port }}:80
PublishPort={{ quadlets_nginx_proxy_https_port }}:443

SecurityLabelType=spc_t

# Config bind-mounts — all paths resolve via %E to ~/.config/nginx-proxy/
Volume=%E/nginx-proxy/certs:/etc/nginx/certs:ro,Z
Volume=%E/nginx-proxy/vhost.d:/etc/nginx/vhost.d:ro,Z
Volume=%E/nginx-proxy/conf.d/custom.conf:/etc/nginx/conf.d/custom.conf:ro,Z

# Podman socket — %t resolves to /run/user/<UID>/ for rootless units
Volume=%t/podman/podman.sock:/tmp/docker.sock:Z

Network={{ quadlets_network_name }}.network

Environment=HTTPS_METHOD={{ quadlets_nginx_proxy_https_method }}
Environment=PROXY_READ_TIMEOUT={{ quadlets_nginx_proxy_read_timeout }}
Environment=PROXY_CONNECT_TIMEOUT={{ quadlets_nginx_proxy_connect_timeout }}
{% for key, value in quadlets_nginx_proxy_extra_env.items() %}
Environment={{ key }}={{ value }}
{% endfor %}

Label=com.github.nginx-proxy.nginx=true

[Service]
Restart=always
# Give the Podman socket a moment to be ready before the container starts
ExecStartPre=/bin/sleep 1

[Install]
WantedBy=multi-user.target
